\makeatletter
\def\@makechapterhead#1{\thispagestyle{fancy}%
  \vspace*{20\p@}%
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \if@mainmatter
       	\Huge\centerline{\thechapter. #1}
        \par\nobreak
        \vskip 10\p@
      \else
      	\Huge \centerline{#1}\par\nobreak
      \fi
    \fi
    \interlinepenalty\@M
    \vskip 10\p@
    \cfoot{}
	\rfoot{\thepage}
    }}
\makeatother


